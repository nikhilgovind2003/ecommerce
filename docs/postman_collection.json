    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "ChangeMe123!"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "rootCategoryId",
      "value": ""
    },
    {
      "key": "childCategoryId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "cancelOrderId",
      "value": ""
    },
    {
      "key": "cancelOrderId",
      "value": ""
