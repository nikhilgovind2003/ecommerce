# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Used only by `npm test`. Tests create and drop their own databases on this server,
# so never point it at data you care about.
MONGO_URI_TEST=mongodb://127.0.0.1:27017

# JWT - use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# First admin account, created by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Rate limiting (window is shared by both limiters)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Orders: "true" forces MongoDB transactions (needs a replica set), "false" disables them.
# Leave empty to auto-detect.
USE_TRANSACTIONS=
